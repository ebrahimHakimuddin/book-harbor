# Name shown to readers when they connect to this instance.
BOOKHARBOR_NAME=My BookHarbor

# Host port published by Docker Compose.
BOOKHARBOR_PORT=8080

# Maximum size of one uploaded book in bytes (default: 512 MiB).
BOOKHARBOR_MAX_UPLOAD_BYTES=536870912

# Optional. Enables administrator metadata search through Hardcover.
# Create a personal API token at https://hardcover.app/account/api.
BOOKHARBOR_HARDCOVER_TOKEN=
